<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Event DTOs are generated from JSON Schema; the schema, not the generated code, is the reviewed artifact. -->
    <Match>
        <Package name="~io\.github\.egeozdemirr\.corebank\.contracts\.events(\..*)?"/>
    </Match>

    <!-- gRPC messages and stubs are generated by protoc; the .proto file is the reviewed artifact (ADR-0004). -->
    <Match>
        <Package name="~io\.github\.egeozdemirr\.corebank\.contracts\.grpc(\..*)?"/>
    </Match>

    <!--
        Application services and their collaborators (transaction recorders, workflow steps) receive ports and other
        services through constructor injection. Sharing those instances is the point of dependency injection, so
        EI_EXPOSE_REP2 does not apply to them.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="~io\.github\.egeozdemirr\.corebank\.[a-z]+\.application\.[A-Za-z]+(Service|Recorder|Step)"/>
    </Match>
</FindBugsFilter>
