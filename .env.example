# Copy to .env (git-ignored) and change the values. Never commit a real secret.
# docker compose reads this file automatically; account-service imports it for local runs.

# account-service database
ACCOUNT_DB_NAME=corebank_account
ACCOUNT_DB_USERNAME=corebank
ACCOUNT_DB_PASSWORD=change-me
ACCOUNT_DB_URL=jdbc:postgresql://localhost:5432/corebank_account

# account-service
ACCOUNT_SERVICE_PORT=8081
# Five-digit bank code used in generated IBANs. Must not belong to a real bank; 99999 is unassigned.
COREBANK_SYNTHETIC_BANK_CODE=99999

# Host ports (change if something else already listens on them)
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092

# Kafka topics: retention of 7 days so that later consumers can replay
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=604800000
