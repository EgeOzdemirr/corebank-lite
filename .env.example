# Copy to .env (git-ignored) and change the values. Never commit a real secret.
# docker compose reads this file automatically; account-service imports it for local runs.

# account-service database
ACCOUNT_DB_NAME=corebank_account
ACCOUNT_DB_USERNAME=corebank
ACCOUNT_DB_PASSWORD=change-me
ACCOUNT_DB_URL=jdbc:postgresql://localhost:5432/corebank_account

# transfer-service database: a second database in the same PostgreSQL, created on the first start (an existing
# data volume keeps its databases; run `docker compose down -v` once to recreate it, which deletes local data).
TRANSFER_DB_NAME=corebank_transfer
TRANSFER_DB_USERNAME=corebank
TRANSFER_DB_PASSWORD=change-me
TRANSFER_DB_URL=jdbc:postgresql://localhost:5432/corebank_transfer

# account-service: HTTP API and the internal gRPC API used by transfer-service (ADR-0004)
ACCOUNT_SERVICE_PORT=8080
ACCOUNT_SERVICE_GRPC_PORT=9090

# Five-digit bank code used in generated IBANs. Must not belong to a real bank; 99999 is unassigned.
COREBANK_SYNTHETIC_BANK_CODE=99999

# transfer-service: HTTP API, and where it reaches account-service's gRPC API (plaintext until roadmap week 4)
TRANSFER_SERVICE_PORT=8081
ACCOUNT_SERVICE_GRPC_TARGET=static://localhost:9090

# Host ports (change if something else already listens on them)
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092

# Kafka topics: retention of 7 days so that later consumers can replay
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=604800000
