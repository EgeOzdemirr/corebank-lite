{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egeozdemirr.github.io/corebank-lite/schemas/common/monetary-amount.v1.json",
  "title": "MonetaryAmount v1",
  "description": "A positive amount with its currency. The amount is a decimal string with exactly two fraction digits so that no consumer ever parses money as a binary floating point number.",
  "javaType": "io.github.egeozdemirr.corebank.contracts.events.common.MonetaryAmountV1",
  "type": "object",
  "properties": {
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,16})\\.[0-9]{2}$",
      "description": "Decimal string, scale 2, for example \"1500.00\"."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 alphabetic currency code."
    }
  },
  "required": ["amount", "currency"],
  "additionalProperties": false
}
